#!/bin/bash
# ============================================================
# EC2 が初めて起動したときに、1回だけ動く準備の手順
# Terraform（compute.tf）が、ドル記号と波かっこで囲んだ部分に値を入れてから EC2 に渡す
# 進み具合は、EC2 に SSH で入って sudo tail -f /var/log/cloud-init-output.log で見られる
# パスワードなどの秘密は、ここには書かない
# ============================================================
set -euxo pipefail

# ------------------------------------------------------------
# 1. OS を新しくして、nginx を入れる
# ------------------------------------------------------------
dnf -y update
dnf -y install nginx tar xz

# ------------------------------------------------------------
# 2. Node.js（自分のパソコンと同じ版）を、公式のファイルから入れる
#    ファイルが壊れたり、すりかえられたりしていないか、公式の一覧（SHASUMS256.txt）で確かめる
# ------------------------------------------------------------
NODE_VERSION="${node_version}"
NODE_DIST="node-v$NODE_VERSION-linux-arm64"
cd /tmp
curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/$NODE_DIST.tar.xz"
curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt"
grep " $NODE_DIST.tar.xz\$" SHASUMS256.txt | sha256sum -c -
tar -xJf "$NODE_DIST.tar.xz" -C /opt
for cmd in node npm npx; do
  ln -sf "/opt/$NODE_DIST/bin/$cmd" "/usr/local/bin/$cmd"
done
node -v

# ------------------------------------------------------------
# 3. 処理側を動かす利用者と、置き場所を作る
#    - プログラムは ec2-user（SSH で入る利用者）が deploy.ps1 で置く
#    - 処理側は kakeibo という利用者で動かす（できることを少なくするため）
# ------------------------------------------------------------
useradd --system --no-create-home --shell /sbin/nologin kakeibo
#    - /opt/kakeibo/database には、テーブルを作る SQL などを置く（backend/scripts/setup-db.mjs が使う）
mkdir -p /opt/kakeibo/backend /opt/kakeibo/database /opt/kakeibo/bin /var/www/kakeibo /etc/kakeibo
chown ec2-user:ec2-user /opt/kakeibo/backend /opt/kakeibo/database /var/www/kakeibo

# 処理側の設定（パスワード以外）
cat > /etc/kakeibo/backend.env <<'EOF'
HOST=127.0.0.1
PORT=3000
DB_HOST=${db_host}
DB_PORT=3306
DB_USER=kakeibo_app
DB_NAME=${db_name}
NODE_ENV=production
EOF
chmod 644 /etc/kakeibo/backend.env

# 処理側を起動するスクリプト：パスワードを SSM パラメータストアから読んでから起動する
cat > /opt/kakeibo/bin/start-backend.sh <<'EOF'
#!/bin/bash
set -euo pipefail
DB_PASSWORD="$(aws ssm get-parameter --region ${region} --name '${db_password_parameter}' --with-decryption --query Parameter.Value --output text)"
export DB_PASSWORD
exec /usr/local/bin/node /opt/kakeibo/backend/src/server.js
EOF
chmod 755 /opt/kakeibo/bin/start-backend.sh

# ------------------------------------------------------------
# 4. 処理側をサービス（systemd）として登録する
#    EC2 が起動したら自動で動き、止まったら自動で起動し直す。
#    プログラムが置かれるまでは動かない（ConditionPathExists）
# ------------------------------------------------------------
cat > /etc/systemd/system/kakeibo-backend.service <<'EOF'
[Unit]
Description=kakeibo backend (Node.js + Express)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/kakeibo/backend/src/server.js

[Service]
Type=simple
User=kakeibo
Group=kakeibo
WorkingDirectory=/opt/kakeibo/backend
EnvironmentFile=/etc/kakeibo/backend.env
# kakeibo には家のフォルダがないので、AWS CLI が使う一時的な置き場所を /tmp にする
Environment=HOME=/tmp
ExecStart=/opt/kakeibo/bin/start-backend.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable kakeibo-backend

# deploy.ps1 が、sudo を使わずに処理側を起動し直せるようにする（このコマンドだけ）
cat > /etc/sudoers.d/kakeibo-deploy <<'EOF'
ec2-user ALL=(root) NOPASSWD: /usr/bin/systemctl restart kakeibo-backend, /usr/bin/systemctl status kakeibo-backend --no-pager
EOF
chmod 440 /etc/sudoers.d/kakeibo-deploy

# ------------------------------------------------------------
# 5. nginx の設定：画面のファイルを配り、/api を処理側に中継する
# ------------------------------------------------------------
cat > /etc/nginx/nginx.conf <<'EOF'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log   /var/log/nginx/access.log;
    sendfile     on;
    keepalive_timeout 65;
    # nginx の版を返さない（攻撃の手がかりを減らす）
    server_tokens off;

    server {
        listen 80 default_server;
        server_name _;
        root  /var/www/kakeibo;
        index index.html;

        # /api で始まるお願いは、同じ EC2 の中の処理側（127.0.0.1:3000）に中継する
        location /api/ {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            # 処理側は 10KB より大きい本文を受け付けない。nginx でも大きすぎるものは止める
            client_max_body_size 16k;
        }

        # Vite が作るファイル（名前に中身の印が付いている）は、長くためておいてよい
        location /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        # それ以外：ファイルがなければ index.html を返す（Vue Router が画面を切り替えるため）
        location / {
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ /index.html;
        }
    }
}
EOF

# アプリを載せる前に表示する仮の画面
cat > /var/www/kakeibo/index.html <<'EOF'
<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><title>家計簿アプリ</title></head>
<body><p>準備中です。</p></body></html>
EOF
chown ec2-user:ec2-user /var/www/kakeibo/index.html

nginx -t
systemctl enable --now nginx

echo "準備が終わりました"
