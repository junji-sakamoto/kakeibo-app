#!/bin/bash
# ============================================================
# EC2 が初めて起動したときに、1回だけ動く準備の手順
#   第2段階：Node.js を入れる／第3段階：mysql コマンドを入れる／第4段階：git を入れる／
#   第5段階：nginx を入れて設定し、処理側を systemd に登録する
# Terraform（compute.tf）が、ドル記号と波かっこで囲んだ部分に値を入れてから EC2 に渡す
# 進み具合は、EC2 に SSH で入って sudo tail -n 20 /var/log/cloud-init-output.log で見られる
# ============================================================
set -euxo pipefail

# ------------------------------------------------------------
# Node.js（自分のパソコンと同じ版）を、Node.js の公式のファイルから入れる
#   - EC2 は Arm（aarch64）なので、linux-arm64 のファイルを使う
#   - ファイルが壊れたり、すりかえられたりしていないか、公式の一覧（SHASUMS256.txt）で確かめる
#   - npm（部品を入れる道具）も一緒に入る
# ------------------------------------------------------------
#   - Node.js が使う部品（libatomic）は Amazon Linux 2023 に初めから入っていないので、先に入れる
#     （入れないと「libatomic.so.1: cannot open shared object file」で動かない。2026年11月5日に実際に起きた）
dnf -y install libatomic tar xz

NODE_VERSION="${node_version}"
NODE_DIST="node-v$NODE_VERSION-linux-arm64"
cd /tmp
curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/$NODE_DIST.tar.xz"
curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt"
grep " $NODE_DIST.tar.xz\$" SHASUMS256.txt | sha256sum -c -
tar -xJf "$NODE_DIST.tar.xz" -C /opt
# どこからでも node・npm・npx と打てるようにする
for cmd in node npm npx; do
  ln -sf "/opt/$NODE_DIST/bin/$cmd" "/usr/local/bin/$cmd"
done
rm -f "/tmp/$NODE_DIST.tar.xz" /tmp/SHASUMS256.txt

node -v
npm -v
echo "第2段階の準備が終わりました（Node.js $NODE_VERSION）"

# ------------------------------------------------------------
# 第3段階：MySQL 公式の mysql コマンドを入れる（EC2 から RDS につながるかを確かめるため）
#   - MySQL 公式の部品の置き場所（repo.mysql.com）を登録してから、mysql コマンドだけを入れる
#   - データベースそのもの（MySQL のサーバー）は入れない（データベースは RDS を使う）
# ------------------------------------------------------------
#   - MySQL の置き場所は、Linux の種類の番号（el/9 など）でフォルダが分かれている。Amazon Linux 2023 では
#     その番号（$releasever）が「2023.…」になり、ないフォルダを探して 404 になるので、9 に置きかえる
#     （2026年11月5日に実際に起きた）
MYSQL_CLIENT_VERSION="${mysql_client_version}"
dnf -y install https://repo.mysql.com/mysql84-community-release-el9-2.noarch.rpm
sed -i 's/\$releasever/9/g' /etc/yum.repos.d/mysql-community*.repo
dnf -y install "mysql-community-client-$MYSQL_CLIENT_VERSION"
mysql --version
echo "第3段階の準備が終わりました（mysql $MYSQL_CLIENT_VERSION）"

# ------------------------------------------------------------
# 第4段階：git を入れる（アプリのファイルを GitHub から取ってくるため）
# ------------------------------------------------------------
dnf -y install git
git --version
echo "第4段階の準備が終わりました（git）"

# ------------------------------------------------------------
# 第5段階：本番らしい形で動かす準備
#   - 画面（フロントエンド）：npm run build で組み立てたファイルを nginx が 80番で配る。/api は処理側に中継する
#   - 処理側（バックエンド）：systemd に kakeibo-backend として登録し、自動で動かす
#   ここでは準備だけをする。アプリのファイルは、あとで infra/deploy.ps1 が GitHub から取ってきて置く
#   （docs/03_手順書/07_AWSへの公開の手順書.md の 3章）
# ------------------------------------------------------------
dnf -y install nginx

# 組み立てた画面のファイルの置き場所（ec2-user が置き、nginx が読む）。置くまでは「準備中」と出す
mkdir -p /var/www/kakeibo
cat > /var/www/kakeibo/index.html <<'EOF'
<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><title>家計簿（準備中）</title></head>
<body><p>準備中です。アプリの画面はまだ置かれていません。</p></body></html>
EOF
chown -R ec2-user:ec2-user /var/www/kakeibo

# nginx の設定：80番で画面を配り、/api を処理側（127.0.0.1:3000）に中継する
cat > /etc/nginx/nginx.conf <<'EOF'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log   /var/log/nginx/access.log;
    sendfile     on;
    keepalive_timeout 65;
    # nginx の版を返さない（攻撃の手がかりを減らす）
    server_tokens off;

    server {
        listen 80 default_server;
        server_name _;
        root  /var/www/kakeibo;
        index index.html;

        # /api で始まるお願いは、同じ EC2 の中の処理側に中継する
        location /api/ {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # 処理側は 10KB より大きい本文を受け付けない。nginx でも大きすぎるものは止める
            client_max_body_size 16k;
        }

        # Vite が組み立てたファイル（名前に中身の印が付いている）は、長くためておいてよい
        location /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        # それ以外：ファイルがなければ index.html を返す（Vue Router が画面を切り替えるため。/categories での再読み込みなど）
        location / {
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ /index.html;
        }
    }
}
EOF
nginx -t
systemctl enable --now nginx

# 処理側（バックエンド）を systemd に登録する。.env が置かれるまでは動かない（ConditionPathExists）
cat > /etc/systemd/system/kakeibo-backend.service <<'EOF'
[Unit]
Description=kakeibo backend (Node.js + Express)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ec2-user/kakeibo-app/backend/.env

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/kakeibo-app/backend
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node --env-file=.env src/server.js
# 止まったら3秒後に自動で起動し直す
Restart=always
RestartSec=3
# 処理側にできることを少なくする
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable kakeibo-backend
echo "第5段階の準備が終わりました（nginx・kakeibo-backend の登録）"
