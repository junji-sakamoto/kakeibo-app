# ============================================================
# 外から渡す値の見本
# このファイルをコピーして terraform.tfvars という名前にし、値を書き換える
# terraform.tfvars は GitHub に上げない（.gitignore で除外している）
# ============================================================

# 自分のパソコンの IP アドレス（SSH で EC2 に入ってよい場所）
# 調べ方：(Invoke-RestMethod https://checkip.amazonaws.com).Trim()
my_ip = "203.0.113.10"

# 予算をこえそうなときに知らせるメールアドレス
alert_email = "you@example.com"
