#!/bin/sh
# ============================================================
# コミットする前に、自動で動く確認（Git のフック）
# 要件定義の資料を直したのに、1冊の「要件定義書.md」を作り直し忘れていないかを確かめる
#
# このフックを使う設定（パソコンごとに1回だけ）：
#   git config core.hooksPath .githooks
# ============================================================

# ① 1冊が、分けた資料と同じ内容（最新）になっているか
if ! node tools/build_requirements.mjs --check; then
  echo ""
  echo "【コミットを止めました】要件定義書.md が最新ではありません。"
  echo "  次のコマンドで作り直してから、もう一度コミットしてください。"
  echo "    node tools/build_requirements.mjs"
  echo "    git add 要件定義書.md"
  exit 1
fi

# ② 作り直した 要件定義書.md を、コミットに入れ忘れていないか
#    git status の2文字目が「M」「D」（コミットに入れていない変更がある）、
#    または「??」（一度もコミットに入れていない新しいファイル）のときは止める
state=$(git status --porcelain -- 要件定義書.md)
case "$state" in
  "??"* | ?M* | ?D*)
    echo ""
    echo "【コミットを止めました】作り直した 要件定義書.md が、コミットに入っていません。"
    echo "  次のコマンドで入れてから、もう一度コミットしてください。"
    echo "    git add 要件定義書.md"
    exit 1
    ;;
esac

exit 0
