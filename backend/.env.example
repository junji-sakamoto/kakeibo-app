# 処理側（バックエンド）の設定の見本
# このファイルをコピーして「.env」という名前にし、値を書き換える
# .env は GitHub に上げない（.gitignore で除外している）

# 処理側が待ち受ける場所（127.0.0.1 = 自分のパソコンからだけ受け付ける）
HOST=127.0.0.1
PORT=3000

# データベースにつなぐための情報
# 自分のパソコンでは、database/.env の MYSQL_USER・MYSQL_PASSWORD・MYSQL_DATABASE と同じ値にする
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kakeibo_app
DB_PASSWORD=ここにアプリ用のパスワード
DB_NAME=kakeibo
